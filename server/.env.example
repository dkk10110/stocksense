DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/stocksense?schema=public"
JWT_SECRET="change-me-to-a-long-random-string"
PORT=4000
CORS_ORIGIN="http://localhost:5173"

# Optional — only needed for live intraday price / India VIX (Phase 3's Angel One integration).
# Daily price data (Yahoo Finance, NSE bhavcopy) works without these.
ANGEL_ONE_API_KEY=
ANGEL_ONE_CLIENT_CODE=
ANGEL_ONE_PASSWORD=
ANGEL_ONE_TOTP_SECRET=

# Optional — comma-separated NSE tickers for the scan universe (union'd with watchlist + active signals).
# Defaults to a built-in ~10-symbol list. Keep near 20-30 to stay inside the NewsAPI free tier.
TRACKED_SYMBOLS=

# News source for the catalyst detector + news-sentiment scoring layer.
#   NEWS_PROVIDER=google   (default) — Google News RSS. Free, no key, works in production.
#   NEWS_PROVIDER=marketaux — marketaux.com free key (finance-specific, ticker-tagged). Set MARKETAUX_API_KEY.
#   NEWS_PROVIDER=newsapi   — newsapi.org. Free key is dev-only (blocked on deployed servers). Set NEWS_API_KEY.
#   NEWS_PROVIDER=yahoo     — Yahoo Finance news. Free, no key, but weak NSE/BSE coverage.
NEWS_PROVIDER=google
MARKETAUX_API_KEY=
NEWS_API_KEY=

# Optional — "why buy now" text generation + v4 AI Narrative Engine + news sentiment + drop
# classification + catalyst extraction. Without it, rule-based templates / neutral fallbacks are used.
ANTHROPIC_API_KEY=

# Optional (v4.0 FRD tuning) — discovery-scan shortlist size; the v4 confidence at/above which
# a shortlist entry is promoted to a real Signal (feed + paper trading); and the confidence
# at/above which the AI narrative is generated (below it, a deterministic template is used).
DISCOVERY_SHORTLIST=12
DISCOVERY_PROMOTE_CONFIDENCE=70
NARRATIVE_MIN_CONFIDENCE=70

# Optional — real WhatsApp alert delivery. Without these, alerts still get written to the Alerts
# screen in-app, they just aren't pushed to WhatsApp. Recipient number in E.164 (e.g. 919812345678).
WHATSAPP_TO=
# Provider: "cloud" (WhatsApp Cloud API / Meta, default) or "twilio".
WHATSAPP_PROVIDER=cloud

# --- WhatsApp Cloud API (Meta) ---  https://developers.facebook.com → WhatsApp → API Setup
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
# Optional — a pre-approved message template name, REQUIRED for alerts sent outside the 24h
# customer-service window. The alert text is passed as body parameter {{1}}. Leave blank to send
# free-form text (works only within 24h of the recipient messaging your number / for testing).
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=en
WHATSAPP_GRAPH_VERSION=v21.0

# --- Twilio WhatsApp (only if WHATSAPP_PROVIDER=twilio) ---  https://console.twilio.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Optional — password-reset emails (Phase 8). Without these, the reset link is logged to the
# server console instead of emailed. Any standard SMTP provider works (Gmail app password, etc).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Optional — only needed if `pg_dump` isn't on PATH. Defaults to bare "pg_dump".
PG_DUMP_PATH="C:\Program Files\PostgreSQL\17\bin\pg_dump.exe"
