DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/stocksense?schema=public"
JWT_SECRET="change-me-to-a-long-random-string"
PORT=4000
CORS_ORIGIN="http://localhost:5173"

# Optional — only needed for live intraday price / India VIX (Phase 3's Angel One integration).
# Daily price data (Yahoo Finance, NSE bhavcopy) works without these.
ANGEL_ONE_API_KEY=
ANGEL_ONE_CLIENT_CODE=
ANGEL_ONE_PASSWORD=
ANGEL_ONE_TOTP_SECRET=

# Optional — only needed for the catalyst-countdown detector (Phase 4/5). Free tier at newsapi.org.
NEWS_API_KEY=

# Optional — "why buy now" text generation (Phase 5). Without it, a rule-based template is used instead.
ANTHROPIC_API_KEY=

# Optional — real Telegram alert delivery (Phase 6). Without these, alerts still get written to the
# Alerts screen in-app, they just aren't pushed to Telegram. Get a token from @BotFather, and your
# chat ID by messaging the bot once and checking https://api.telegram.org/bot<token>/getUpdates.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional — password-reset emails (Phase 8). Without these, the reset link is logged to the
# server console instead of emailed. Any standard SMTP provider works (Gmail app password, etc).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Optional — only needed if `pg_dump` isn't on PATH. Defaults to bare "pg_dump".
PG_DUMP_PATH="C:\Program Files\PostgreSQL\17\bin\pg_dump.exe"
